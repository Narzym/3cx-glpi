# Skopiuj ten plik jako ".env" i uzupelnij. Plik .env NIGDY nie trafia do gita (jest w .gitignore).
# Wiersze z "#" na poczatku pokazuja wartosci domyslne - odkomentuj tylko to, co chcesz zmienic.

# ---- GLPI REST API (wymagane) ----
GLPI_API_URL=https://helpdesk.twojadomena.pl/api.php/v1
GLPI_APP_TOKEN=wklej_app_token
GLPI_USER_TOKEN=wklej_user_token_konta_api
# Konto API musi miec profil z prawem: tworzenia i przypisywania ticketow oraz
# odczytu: Zasoby -> Telefony, Uzytkownicy, Listy rozwijane -> Lokalizacje.

# ---- Centrala 3CX ----
# THREECX_HOST=212.180.155.28
# THREECX_PORT=5001
# IT_NUMBER_PREFIX=225435
# RECONNECT_DELAY=5

# ---- Telefony IT z GLPI (Zasoby -> Telefony) ----
# Jak dlugo (s) trzymac przypisania w cache. 0 = pytaj GLPI przy kazdym polaczeniu.
# GLPI_PHONES_CACHE_TTL=30

# ---- Baza i logi ----
# DB_PATH=cdrdatabase.db
# LOG_PATH=logs/cdr_to_glpi.log
# Rotacja logow: rozmiar jednego pliku w bajtach (0 = wylaczona) i liczba kopii.
# LOG_MAX_BYTES=5242880
# LOG_BACKUP_COUNT=5
# Tryb SQLite: WAL (domyslnie) albo DELETE (klasyczny, awaryjny powrot).
# DB_JOURNAL_MODE=WAL
# DB_BUSY_TIMEOUT_SECONDS=10

# ---- Polaczenia HTTP z GLPI ----
# GLPI_HTTP_TIMEOUT=15
# GLPI_HTTP_CONNECT_TIMEOUT=5
# Ile razy ponowic zapytanie GET po chwilowym bledzie (502/503/504, zerwane polaczenie).
# Tworzenie ticketu (POST) NIE jest ponawiane po bledzie serwera - zeby nie robic duplikatow.
# GLPI_HTTP_RETRIES=2
# GLPI_HTTP_BACKOFF=0.5

# ---- Tickety ----
# GLPI_HELPDESK_GROUP_ID=27
# GLPI_CATEGORY_ID=16
# GLPI_SET_ROOM_AS_LOCATION=1
# GLPI_AUTO_FETCH_LOCATIONS_ON_MISS=0
# MISSED_CALL_START_HOUR=8
# MISSED_CALL_END_HOUR=20
